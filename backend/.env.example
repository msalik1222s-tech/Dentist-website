# Copy this file to .env and fill in your own values. Never commit .env.
# On Vercel these go in Project Settings -> Environment Variables instead.

PORT=5500

# Set this ONLY if the app runs behind a reverse proxy (nginx, Cloudflare, a
# PaaS): the number of proxies in front of it, e.g. TRUST_PROXY=1. Leave it
# empty when the app faces the internet directly — otherwise anyone can spoof
# X-Forwarded-For and bypass the rate limits.
TRUST_PROXY=

# --- Database ---
# Required on Vercel: its filesystem is read-only, so appointments cannot be
# written to a JSON file there. Any Postgres connection string works (Neon,
# Supabase, Railway...). Tables are created automatically on first request.
# Leave empty for local development to fall back to backend/data/appointments.json.
DATABASE_URL=

# Key required to view submitted appointment requests at /api/appointments and /admin.html
# Pick any long random string.
ADMIN_KEY=change-me-to-a-long-random-string

# --- Email notifications (optional) ---
# Leave SMTP_HOST empty to disable email; requests are still saved to the database.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Address appointment requests are sent to (the clinic's inbox)
CLINIC_EMAIL=
# "From" address shown on the notification email (often must match SMTP_USER for your provider)
FROM_EMAIL=

# --- AI chat assistant ---
# Paste your OpenAI secret key here (it starts with "sk-"). Get one at
# https://platform.openai.com/api-keys — leave empty to disable the chat widget.
# This is read by the backend only and is never sent to the browser.
OPENAI_API_KEY=
# Override the model if needed; defaults to gpt-4o-mini.
OPENAI_MODEL=
# Optional: an OpenAI-compatible base URL (Azure/gateway/proxy). Leave empty for api.openai.com.
OPENAI_BASE_URL=

# Optional alternative provider. Leave ANTHROPIC_API_KEY empty unless you want
# to run the assistant on Claude instead of OpenAI.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
# Force a provider when both keys are set: "openai" or "anthropic".
# Leave empty to use OpenAI whenever OPENAI_API_KEY is present.
CHAT_PROVIDER=
