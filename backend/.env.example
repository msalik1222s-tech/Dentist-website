# Copy this file to .env and fill in your own values. Never commit .env.
# On Vercel these go in Project Settings -> Environment Variables instead.

PORT=5500

# --- Database ---
# Required on Vercel: its filesystem is read-only, so appointments cannot be
# written to a JSON file there. Any Postgres connection string works (Neon,
# Supabase, Railway...). Tables are created automatically on first request.
# Leave empty for local development to fall back to backend/data/appointments.json.
DATABASE_URL=

# Key required to view submitted appointment requests at /api/appointments and /admin.html
# Pick any long random string.
ADMIN_KEY=change-me-to-a-long-random-string

# --- Email notifications (optional) ---
# Leave SMTP_HOST empty to disable email; requests are still saved to the database.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Address appointment requests are sent to (the clinic's inbox)
CLINIC_EMAIL=
# "From" address shown on the notification email (often must match SMTP_USER for your provider)
FROM_EMAIL=

# --- AI chat assistant (optional) ---
# Get a key from https://console.anthropic.com/ — leave empty to disable the chat widget.
ANTHROPIC_API_KEY=
# Override the model if needed; defaults to claude-sonnet-5.
ANTHROPIC_MODEL=
