# Copy this file to .env and fill in your own values. Never commit .env.
# On Vercel these go in Project Settings -> Environment Variables instead.

PORT=5500

# --- Database ---
# Required on Vercel: its filesystem is read-only, so appointments and chat
# history cannot be written to a JSON file there. Any Postgres connection
# string works (Neon, Supabase, Railway...). Tables are created automatically
# on first request. Leave empty for local development to fall back to
# backend/data/*.json.
DATABASE_URL=

# Key required for /admin.html and every /api/admin/* endpoint.
# Pick any long random string.
ADMIN_KEY=change-me-to-a-long-random-string

# --- Email notifications (optional) ---
# Leave SMTP_HOST empty to disable email; bookings and handoffs are still saved.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Address notifications are sent to (the clinic's inbox)
CLINIC_EMAIL=
# "From" address on the notification email (often must match SMTP_USER)
FROM_EMAIL=

# ===========================================================================
# AI Agent — "Dental Care Assistant"
# ===========================================================================

# Which LLM to use: anthropic | openai | google | mock
# Leave empty and it picks whichever provider has an API key set below, so an
# existing deployment with only ANTHROPIC_API_KEY keeps working unchanged.
AI_PROVIDER=

# --- Anthropic (Claude) ---
# Get a key from https://console.anthropic.com/
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# --- OpenAI (or any OpenAI-compatible gateway) ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1

# --- Google Gemini ---
GOOGLE_API_KEY=
GOOGLE_MODEL=gemini-2.0-flash

# --- Generation tuning (all optional) ---
# AI_MAX_TOKENS=1024
# AI_TEMPERATURE=0.3
# AI_TIMEOUT_MS=45000
# How many rounds of tool calls one reply may take before the agent gives up
# and points the patient at a human.
# AI_MAX_TOOL_TURNS=6

# --- Memory (all optional) ---
# Turns replayed to the model verbatim.
# AI_MEMORY_WINDOW=16
# Message count at which older turns start being folded into a summary.
# AI_SUMMARY_TRIGGER=24
# AI_SUMMARY_MAX_CHARS=1200
# Longest single patient message accepted (longer ones are truncated).
# AI_MAX_MESSAGE_CHARS=2000
# Messages after which a session is retired and the patient asked to start again.
# AI_MAX_SESSION_MESSAGES=300

# --- Guardrails (optional) ---
# When true, a reply quoting a price no tool returned is replaced instead of
# just logged. Watch the logs for "unverified_price" before switching this on:
# a legitimate reply can total two services up and trip it.
# AI_STRICT_PRICE_GUARD=false

# How long the catalogue (services, doctors, FAQs) is cached per instance.
# CATALOG_TTL_MS=60000

# ===========================================================================
# WhatsApp (optional)
# ===========================================================================
# Leave WHATSAPP_ENABLED empty to keep the channel off. See docs/ai-agent.md
# for the full setup, including how to point the platform at the webhook.

WHATSAPP_ENABLED=
# meta (WhatsApp Cloud API) or twilio
WHATSAPP_PROVIDER=meta

# Number shown to patients when the assistant points them at WhatsApp.
WHATSAPP_CONTACT_NUMBER=

# --- Meta WhatsApp Cloud API ---
# A token you choose; Meta echoes it back when verifying the webhook URL.
WHATSAPP_VERIFY_TOKEN=
# App Secret from the Meta app dashboard. Every inbound webhook is verified
# against it — without it the endpoint refuses every request.
WHATSAPP_APP_SECRET=
# Permanent access token for the WhatsApp Business account.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_GRAPH_VERSION=v21.0

# --- Twilio (only when WHATSAPP_PROVIDER=twilio) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
# Twilio signs the exact URL it called, so this must match the webhook URL
# configured on the number, scheme and path included.
PUBLIC_BASE_URL=
